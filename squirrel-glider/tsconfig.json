{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    /*
     * Where `three` comes from, for TypeScript. Files in shared/ import it
     * from above this folder, where the only node_modules is the repo root's
     * — which a deploy never installs. Pointing it at this game's own typings
     * settles it wherever the build runs; the runtime half is the alias in
     * vite.config.ts. Every game carries this.
     */
    "baseUrl": ".",
    "paths": {
      "three": ["./node_modules/@types/three"],
      "three/*": ["./node_modules/@types/three/*"]
    }
  },
  "include": ["src"]
}
